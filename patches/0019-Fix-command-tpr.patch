-        return config.getDouble(locationKey(name, "max-range"), getCenter(name).getWorld().getWorldBorder().getSize() / 2);
+        return config.getDouble(locationKey(name, "max-range"), getRawCenter(name).getWorld().getWorldBorder().getSize() / 2);
