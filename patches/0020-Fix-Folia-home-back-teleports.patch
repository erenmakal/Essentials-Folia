From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: erenmakal <erenmakal@users.noreply.github.com>
Date: Sun, 30 Aug 2026 01:24:00 +0300
Subject: [PATCH] Fix Folia home and back teleport ordering

Keep location safety work on the destination region and entity teleport work
on the player's entity scheduler. Snapshot player state before leaving the
entity-owned command context and keep the Essentials teleport future pending
until Folia's teleportAsync has actually completed.

This prevents /home and /back from doing destination block work on the wrong
Folia region and removes premature successful completion of the shared
teleport pipeline.

diff --git a/Essentials/src/main/java/com/earth2me/essentials/AsyncTeleport.java b/Essentials/src/main/java/com/earth2me/essentials/AsyncTeleport.java
index a010b7dde3d0395e1ffadff6201f75a030b0f853..0000000000000000000000000000000000000000 100644
--- a/Essentials/src/main/java/com/earth2me/essentials/AsyncTeleport.java
+++ b/Essentials/src/main/java/com/earth2me/essentials/AsyncTeleport.java
@@ -138,6 +138,23 @@ public class AsyncTeleport implements IAsyncTeleport {
         paperFuture.exceptionally(future::completeExceptionally);
     }
 
+    private void teleportOnEntityThread(final IUser teleportee, final Location loc, final TeleportCause cause, final CompletableFuture<Boolean> future) {
+        final Location destination = loc.clone();
+        ess.getEntityScheduler(teleportee.getBase()).run(ess, scheduledTask -> {
+            try {
+                teleportee.getBase().teleportAsync(destination, cause).whenComplete((success, throwable) -> {
+                    if (throwable != null) {
+                        future.completeExceptionally(throwable);
+                    } else {
+                        future.complete(success);
+                    }
+                });
+            } catch (final Throwable throwable) {
+                future.completeExceptionally(throwable);
+            }
+        }, () -> future.complete(false));
+    }
+
     private void runOnMain(final Runnable runnable) throws ExecutionException, InterruptedException {
         if (VersionUtil.isFoliaServer()) throw new UnsupportedOperationException("Not supported on Folia");
         if (Bukkit.isPrimaryThread()) {
@@ -181,44 +198,52 @@ public class AsyncTeleport implements IAsyncTeleport {
             teleportee.setLastLocation();
         }
 
-        final Location targetLoc = target.getLocation();
+        // Never mutate a Location supplied by a home/back target while the asynchronous
+        // teleport is in flight. Folia may finish the operation on a later region tick.
+        final Location targetLoc = target.getLocation().clone();
+        final org.bukkit.GameMode gameMode = teleportee.getBase().getGameMode();
+        final boolean bypassUnsafeCheck = teleportee.getBase().isOnline()
+                && targetLoc.getWorld().equals(teleportee.getBase().getWorld())
+                && (gameMode == org.bukkit.GameMode.CREATIVE || gameMode == org.bukkit.GameMode.SPECTATOR || teleportee.isGodModeEnabled())
+                && teleportee.getBase().getAllowFlight();
         if (ess.getSettings().isTeleportSafetyEnabled() && !ess.getSettings().isForceDisableTeleportSafety() && LocationUtil.isBlockOutsideWorldBorder(targetLoc.getWorld(), targetLoc.getBlockX(), targetLoc.getBlockZ())) {
             targetLoc.setX(LocationUtil.getXInsideWorldBorder(targetLoc.getWorld(), targetLoc.getBlockX()));
             targetLoc.setZ(LocationUtil.getZInsideWorldBorder(targetLoc.getWorld(), targetLoc.getBlockZ()));
         }
         targetLoc.getWorld().getChunkAtAsync(targetLoc.getBlockX() >> 4, targetLoc.getBlockZ() >> 4, true, true).thenAccept(chunk -> {
-            Location loc = targetLoc;
-            if (LocationUtil.isBlockUnsafeForUser(ess, teleportee, chunk.getWorld(), loc.getBlockX(), loc.getBlockY(), loc.getBlockZ())) {
-                if (ess.getSettings().isTeleportSafetyEnabled()) {
-                    if (ess.getSettings().isForceDisableTeleportSafety()) {
-                        //The chunk we're teleporting to is 100% going to be loaded here, no need to teleport async.
-                        teleportee.getBase().teleportAsync(loc, cause);
+            if (chunk == null) {
+                future.complete(false);
+                return;
+            }
+
+            // getChunkAtAsync only guarantees that the chunk is loaded. Folia still
+            // requires world/block access to happen on the region that owns it.
+            ess.getRegionScheduler().execute(ess, targetLoc, () -> {
+                try {
+                    Location loc = targetLoc.clone();
+                    final boolean unsafe = !bypassUnsafeCheck
+                            && (LocationUtil.isBlockUnsafe(ess, loc.getWorld(), loc.getBlockX(), loc.getBlockY(), loc.getBlockZ())
+                            || LocationUtil.isBlockOutsideWorldBorder(loc.getWorld(), loc.getBlockX(), loc.getBlockZ()));
+                    if (unsafe) {
+                        if (ess.getSettings().isTeleportSafetyEnabled()) {
+                            if (!ess.getSettings().isForceDisableTeleportSafety()) {
+                                loc = LocationUtil.getSafeDestination(ess, loc);
+                            }
                         } else {
-                    } else {
-                        try {
-                            //There's a chance the safer location is outside the loaded chunk so still teleport async here.
-                            teleportee.getBase().teleportAsync(LocationUtil.getSafeDestination(ess, teleportee, loc), cause);
-                        } catch (final Exception e) {
-                            future.completeExceptionally(e);
+                            future.completeExceptionally(new TranslatableException("unsafeTeleportDestination", loc.getWorld().getName(), loc.getBlockX(), loc.getBlockY(), loc.getBlockZ()));
                             return;
                         }
-                    }
-                } else {
-                    future.completeExceptionally(new TranslatableException("unsafeTeleportDestination", loc.getWorld().getName(), loc.getBlockX(), loc.getBlockY(), loc.getBlockZ()));
-                    return;
-                }
-            } else {
-                if (ess.getSettings().isForceDisableTeleportSafety()) {
-                    //The chunk we're teleporting to is 100% going to be loaded here, no need to teleport async.
-                    teleportee.getBase().teleportAsync(loc, cause);
-                } else {
-                    if (ess.getSettings().isTeleportToCenterLocation()) {
+                    } else if (!ess.getSettings().isForceDisableTeleportSafety() && ess.getSettings().isTeleportToCenterLocation()) {
                         loc = LocationUtil.getRoundedDestination(loc);
                     }
-                    //There's a *small* chance the rounded destination produces a location outside the loaded chunk so still teleport async here.
-                    teleportee.getBase().teleportAsync(loc, cause);
+
+                    // Entity operations belong to the entity scheduler. The caller future
+                    // is completed only after Folia's teleportAsync has really finished.
+                    teleportOnEntityThread(teleportee, loc, cause, future);
+                } catch (final Throwable throwable) {
+                    future.completeExceptionally(throwable);
                 }
-            }
-            future.complete(true);
+            });
         }).exceptionally(th -> {
             future.completeExceptionally(th);
             return null;
@@ -298,5 +323,4 @@ public class AsyncTeleport implements IAsyncTeleport {
                     return;
                 }
             }
-            future.complete(true);
             return;
@@ -349,5 +373,4 @@ public class AsyncTeleport implements IAsyncTeleport {
                     return;
                 }
             }
-            future.complete(true);
             return;
