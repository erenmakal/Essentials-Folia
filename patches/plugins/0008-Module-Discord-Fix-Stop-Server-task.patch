From aea01d1b1343173139ca3f76660bdaf2fd1126d9 Mon Sep 17 00:00:00 2001
From: Bierque Euphyllia <bierque.euphyllia@gmail.com>
Date: Sun, 26 Apr 2026 13:43:42 +0200
Subject: [PATCH 08/13] Module Discord Fix Stop Server task

---
 .../java/net/essentialsx/discord/EssentialsDiscord.java     | 6 ++++++
 .../java/net/essentialsx/discord/JDADiscordService.java     | 2 +-
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/EssentialsDiscord/src/main/java/net/essentialsx/discord/EssentialsDiscord.java b/EssentialsDiscord/src/main/java/net/essentialsx/discord/EssentialsDiscord.java
index bda1bb69b..00881ae12 100644
--- a/EssentialsDiscord/src/main/java/net/essentialsx/discord/EssentialsDiscord.java
+++ b/EssentialsDiscord/src/main/java/net/essentialsx/discord/EssentialsDiscord.java
@@ -25,6 +25,7 @@ public class EssentialsDiscord extends JavaPlugin implements IEssentialsModule {
     private DiscordSettings settings;
     private boolean isPAPI = false;
     private boolean isEssentialsChat = false;
+    private boolean isDisabled = false;
 
     @Override
     public void onEnable() {
@@ -82,6 +83,7 @@ public class EssentialsDiscord extends JavaPlugin implements IEssentialsModule {
 
     public void onReload() {
         if (jda != null && !jda.isInvalidStartup()) {
+            isDisabled = false;
             jda.updateListener();
             jda.updatePresence();
             jda.updatePrimaryChannel();
@@ -90,6 +92,10 @@ public class EssentialsDiscord extends JavaPlugin implements IEssentialsModule {
         }
     }
 
+    public boolean isDisabled() {
+        return isDisabled || (jda != null && jda.isInvalidStartup());
+    }
+
     public boolean isInvalidStartup() {
         return jda != null && jda.isInvalidStartup();
     }
diff --git a/EssentialsDiscord/src/main/java/net/essentialsx/discord/JDADiscordService.java b/EssentialsDiscord/src/main/java/net/essentialsx/discord/JDADiscordService.java
index 3df7226e6..6c11d81dd 100644
--- a/EssentialsDiscord/src/main/java/net/essentialsx/discord/JDADiscordService.java
+++ b/EssentialsDiscord/src/main/java/net/essentialsx/discord/JDADiscordService.java
@@ -292,7 +292,7 @@ public class JDADiscordService implements DiscordService, IEssentialsModule {
         if (Bukkit.getServer().isPrimaryThread()) {
             Bukkit.getPluginManager().callEvent(event);
         } else {
-            getPlugin().getEss().getGlobalRegionScheduler().execute(getPlugin(), () -> Bukkit.getPluginManager().callEvent(event)); // Euphyllia
+             if (!getPlugin().isDisabled()) getPlugin().getEss().getGlobalRegionScheduler().execute(getPlugin(), () -> Bukkit.getPluginManager().callEvent(event)); // Euphyllia
         }
     }
 
-- 
