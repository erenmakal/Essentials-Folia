Subject: [PATCH 18/22] Fix EssentialsPlayerListener useFlyClickJump

---
 .../com/earth2me/essentials/EssentialsPlayerListener.java     | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/Essentials/src/main/java/com/earth2me/essentials/EssentialsPlayerListener.java b/Essentials/src/main/java/com/earth2me/essentials/EssentialsPlayerListener.java
index dda65453f..a90a56c47 100644
--- a/Essentials/src/main/java/com/earth2me/essentials/EssentialsPlayerListener.java
+++ b/Essentials/src/main/java/com/earth2me/essentials/EssentialsPlayerListener.java
@@ -1026,7 +1026,9 @@ public class EssentialsPlayerListener implements Listener {
                     while (LocationUtil.isBlockDamaging(loc.getWorld(), loc.getBlockX(), loc.getBlockY() - 1, loc.getBlockZ())) {
                         loc.setY(loc.getY() + 1d);
                     }
-                    PaperLib.teleportAsync(user.getBase(), loc, TeleportCause.PLUGIN);
+                    if (VersionUtil.isFoliaServer()) {
+                        user.getBase().teleportAsync(loc, TeleportCause.PLUGIN);
+                    } else PaperLib.teleportAsync(user.getBase(), loc, TeleportCause.PLUGIN);
                 }
             }
 
