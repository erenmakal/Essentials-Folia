From: Euphyllia Bierque <bierque.euphyllia@gmail.com>
Date: Tue, 19 May 2026 12:15:33 +0200
Subject: [PATCH 05/21] Fix command time

---
 .../java/com/earth2me/essentials/commands/Commandtime.java     | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/Essentials/src/main/java/com/earth2me/essentials/commands/Commandtime.java b/Essentials/src/main/java/com/earth2me/essentials/commands/Commandtime.java
index f4ab38193..68034ced0 100644
--- a/Essentials/src/main/java/com/earth2me/essentials/commands/Commandtime.java
+++ b/Essentials/src/main/java/com/earth2me/essentials/commands/Commandtime.java
@@ -97,7 +97,8 @@ public class Commandtime extends EssentialsCommand {
             if (!add) {
                 time -= time % 24000;
             }
-            world.setTime(time + (add ? 0 : 24000) + timeTick);
+            final long timeFinal = time + (add ? 0 : 24000) + timeTick;
+            ess.getGlobalRegionScheduler().execute(ess, () -> world.setTime(timeFinal));
 
             // Re-apply ptime offsets so players maintain their intended visible time
             final long newWorldTime = world.getTime();
